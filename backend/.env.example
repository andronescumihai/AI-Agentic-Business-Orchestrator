# Copiază acest fișier în .env și completează valorile tale reale.
# NU pune niciodată .env pe GitHub (e deja în .gitignore).

# Claude API (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# Gmail API (OAuth2 — completăm la pasul de integrare email)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Praguri / config
ESCALATION_CONFIDENCE_THRESHOLD=0.85
